{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/work/*.{png,jpg,webp,svg}", "/*.{png,svg,ico,txt}"]
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
